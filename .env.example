# Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
DEBUG=True

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=localsbot
DB_USER=postgres
DB_PASSWORD=postgres_password

# Database URL for SQLAlchemy
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@postgres:5432/localsbot

# Redis (for future use)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Application Settings
APP_NAME=LocalAdsBot
LOG_LEVEL=INFO
TIMEZONE=UTC

# Admin Configuration
ADMIN_IDS=123456789,987654321
